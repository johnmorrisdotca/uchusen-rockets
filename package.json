{
  "name": "@johnmorrisdotca/uchusen-rockets",
  "version": "0.24.0",
  "description": "Uchusen Rockets 宇宙船: line drawings and 3D views of rockets, as a web component. Every variant with its own sourced sizes, a typed way to assemble a rocket from parts, stack and separate. No logos. three.js is a peer dependency.",
  "keywords": [
    "rocket",
    "rockets",
    "spaceship",
    "starship",
    "super-heavy",
    "falcon-9",
    "dragon",
    "spaceflight",
    "line-drawing",
    "svg",
    "3d",
    "3d-models",
    "glb",
    "gltf",
    "three",
    "threejs",
    "webgl",
    "web-component",
    "custom-element",
    "react",
    "typescript",
    "data",
    "spaceprogramx",
    "space-program-x",
    "spx",
    "space",
    "spacex",
    "spacecraft",
    "launch-vehicle",
    "saturn-v",
    "apollo",
    "soyuz",
    "space-shuttle",
    "falcon-heavy",
    "new-glenn",
    "sls",
    "nasa"
  ],
  "homepage": "https://johnmorrisdotca.github.io/uchusen-rockets/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/uchusen-rockets.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/uchusen-rockets/issues"
  },
  "author": "John Morris",
  "license": "MIT AND CC-BY-4.0 AND ODbL-1.0",
  "type": "module",
  "sideEffects": [
    "./dist/element.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build/index.d.ts",
      "import": "./dist/build/index.js",
      "default": "./dist/build/index.js"
    },
    "./journey": {
      "types": "./dist/journey/index.d.ts",
      "import": "./dist/journey/index.js",
      "default": "./dist/journey/index.js"
    },
    "./physics": {
      "types": "./dist/physics/index.d.ts",
      "import": "./dist/physics/index.js",
      "default": "./dist/physics/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "default": "./dist/element.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./launches": {
      "types": "./dist/launches/index.d.ts",
      "import": "./dist/launches/index.js",
      "default": "./dist/launches/index.js"
    },
    "./launches/source": {
      "types": "./dist/launches/source.d.ts",
      "import": "./dist/launches/source.js",
      "default": "./dist/launches/source.js"
    },
    "./assets/*": "./dist/assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSES",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node scripts/make-assets.ts",
    "assets": "node scripts/make-assets.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.demo.json",
    "test": "node --test --test-skip-pattern=budget test/*.test.ts && pnpm test:budget",
    "test:budget": "node --test --test-concurrency=1 --test-name-pattern=budget test/*.test.ts",
    "test:package": "pnpm build && node scripts/check-package.ts",
    "test:readme": "pnpm build && node scripts/check-readme-examples.ts",
    "check": "pnpm lint && node scripts/check-copies.mjs && pnpm typecheck && pnpm test && pnpm build && node scripts/check-package.ts",
    "verify": "pnpm check && node scripts/check-readme-examples.ts && pnpm test:demo",
    "prepublishOnly": "pnpm check",
    "site": "pnpm build && node scripts/site.ts",
    "dev": "pnpm site && node scripts/dev.ts",
    "test:demo": "pnpm site && node scripts/docs-site.mjs build && playwright test",
    "test:freeze": "pnpm site && playwright test e2e/freeze.demo.ts --project=chromium-desk",
    "test:usage": "pnpm site && node scripts/check-usage.ts",
    "family:readme": "node scripts/family-readme.mjs",
    "check:standard": "node scripts/check-standard.mjs",
    "screenshots": "pnpm site && node scripts/docs-site.mjs build && node scripts/screenshots.ts",
    "models": "node scripts/reduce-models.ts",
    "models:nasa": "node scripts/reduce-nasa.ts",
    "docs:site": "pnpm build && node scripts/docs-site.mjs build",
    "docs:check": "pnpm build && node scripts/docs-site.mjs check",
    "size": "node scripts/docs-site.mjs size"
  },
  "peerDependencies": {
    "@johnmorrisdotca/hata": ">=1.8.0 <2",
    "react": ">=18",
    "three": ">=0.170.0"
  },
  "peerDependenciesMeta": {
    "@johnmorrisdotca/hata": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@eslint/js": "9.39.5",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@johnmorrisdotca/chikyu-earth": "0.36.0",
    "@johnmorrisdotca/hata": "1.8.0",
    "@johnmorrisdotca/kazoku-ui": "^0.32.0",
    "@johnmorrisdotca/wakusei-planets": "0.17.1",
    "@playwright/test": "1.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "draco3dgltf": "1.5.7",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "jscpd": "4.0.5",
    "marked": "^18.1.3",
    "meshoptimizer": "1.3.0",
    "pagefind": "^1.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rxjs": "^7.8.2",
    "svelte": "^5.57.3",
    "three": "0.186.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
